# Copy to .env for local development. Never commit .env.
# Read only by the API server (server/), except the two VITE_SUPABASE_* values.

# Required for live analysis. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# Optional. Model used for clip analysis (default: gemini-3.6-flash).
GEMINI_MODEL=

# Optional. Model tried once when the main model is overloaded
# (default: gemini-3.5-flash-lite). Set to "none" to disable.
GEMINI_FALLBACK_MODEL=

# Optional. Set to "false" to switch off live analysis (kill switch).
ANALYSIS_ENABLED=true

# Supabase sign-in (Supabase dashboard > Project Settings > API Keys / Data API).
# These two are PUBLIC by design: the browser needs them, and the server uses
# the same ones to check sign-in tokens. Never put the secret / service_role key
# here. When set, live analysis needs a signed-in user. On Vercel they're
# required (live analysis is off without them); locally they're optional.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Upstash Redis for shared rate limits. Required on Vercel (set automatically by
# the Vercel Marketplace Upstash integration). Optional locally: without them the
# dev server keeps limits in memory. KV_REST_API_URL / KV_REST_API_TOKEN also work.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional. Vercel Blob read-write token. Turns on uploads over 4 MB (up to
# 100 MB): the browser uploads the clip to private Blob storage, the server
# analyzes it and then deletes it (blobs also expire after 1 day as a backup).
# On Vercel you don't need it: connecting a Blob store sets BLOB_STORE_ID,
# and the app signs in with Vercel's automatic OIDC login instead. For local
# dev, copy the token from the store's page (.env.local tab). Without either,
# clips are limited to 4 MB.
BLOB_READ_WRITE_TOKEN=

# Optional. Port for the local API server (default: 8787).
API_PORT=8787
