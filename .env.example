# Copy to .env for local development. Never commit .env.
# These are read only by the API server (server/), never by the browser.

# Required for live analysis. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# Optional. Model used for clip analysis (default: gemini-3.6-flash).
GEMINI_MODEL=

# Optional. Model tried once when the main model is overloaded
# (default: gemini-3.5-flash-lite). Set to "none" to disable.
GEMINI_FALLBACK_MODEL=

# Optional. Set to "false" to switch off live analysis (kill switch).
ANALYSIS_ENABLED=true

# Optional. When set, live analysis asks visitors for this code, which protects
# your Gemini quota. Use a few words (e.g. three-random-words), not a short PIN.
# Leave empty to let anyone analyze.
ANALYSIS_ACCESS_CODE=

# Upstash Redis for shared rate limits. Required on Vercel (set automatically by
# the Vercel Marketplace Upstash integration). Optional locally: without them the
# dev server keeps limits in memory. KV_REST_API_URL / KV_REST_API_TOKEN also work.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional. Port for the local API server (default: 8787).
API_PORT=8787
